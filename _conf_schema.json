{
  "api_key": {
    "description": "API Key",
    "hint": "七牛 Modelink 密钥，必填。",
    "type": "string",
    "default": "",
    "secret": true,
    "obvious_hint": true
  },
  "model": {
    "description": "图像模型",
    "hint": "需同时支持文生图和改图。",
    "type": "string",
    "default": "openai/gpt-image-2.5-sunburst",
    "options": [
      "openai/gpt-image-2.5-sunburst",
      "openai/gpt-image-2.5-flare",
      "openai/gpt-image-2"
    ]
  },
  "planning_provider_id": {
    "description": "绘图规划模型",
    "hint": "独立上下文负责搜索、图片核对和构图，需要工具调用与视觉能力；留空复用当前聊天模型，仍不带入聊天历史。",
    "type": "string",
    "default": "",
    "_special": "select_provider"
  },
  "rewrite_provider_ids": {
    "description": "提示词优化模型",
    "hint": "负责提示词整合/关键词优化；第一项优先，后续依次回退，留空跟随会话。图片核对使用绘图规划模型。",
    "type": "list",
    "default": [],
    "items": {
      "type": "string"
    },
    "_special": "select_providers"
  },
  "quality": {
    "description": "画质 quality",
    "hint": "auto 由模型自动决定；更高质量通常耗时更长。",
    "type": "string",
    "default": "auto",
    "options": ["low", "medium", "high", "auto"]
  },
  "size": {
    "description": "尺寸 size",
    "hint": "1024x1024=方图；1536x1024=横图；1024x1536=竖图；2048x2048=2K 方图；2048x1152=2K 横图；3840x2160=4K 横图；2160x3840=4K 竖图。",
    "type": "string",
    "default": "auto",
    "options": [
      "auto",
      "1024x1024",
      "1536x1024",
      "1024x1536",
      "2048x2048",
      "2048x1152",
      "3840x2160",
      "2160x3840"
    ]
  },
  "moderation": {
    "description": "审核严格度 moderation",
    "hint": "low=较宽松；auto=上游默认。公开场景建议 auto。",
    "type": "string",
    "default": "low",
    "options": ["low", "auto"]
  },
  "concurrency": {
    "description": "最大并发出图数",
    "hint": "超出后自动排队。",
    "type": "int",
    "default": 3
  },
  "style_mode": {
    "description": "内置风格",
    "hint": "auto=自动匹配；explicit_only=仅明确点名；disabled=关闭。",
    "type": "string",
    "default": "auto",
    "options": ["auto", "explicit_only", "disabled"]
  },
  "style_strength": {
    "description": "风格强度",
    "hint": "normal=标准；subtle=轻微；strong=强烈。",
    "type": "string",
    "default": "normal",
    "options": ["normal", "subtle", "strong"]
  },
  "triggers": {
    "description": "直接出图触发词",
    "hint": "可选；命中后绕过主聊天模型，适合输入完整提示词。不要填写 Bot 唤醒词。",
    "type": "list",
    "default": [],
    "items": {
      "type": "string"
    }
  }
}
