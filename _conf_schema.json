{
  "api_key": {
    "description": "API Key",
    "hint": "七牛 Modelink 密钥，必填。",
    "type": "string",
    "default": "",
    "secret": true,
    "obvious_hint": true
  },
  "model": {
    "description": "图像模型",
    "hint": "需同时支持文生图和改图。",
    "type": "string",
    "default": "openai/gpt-image-2.5-sunburst",
    "options": [
      "openai/gpt-image-2.5-sunburst",
      "openai/gpt-image-2.5-flare",
      "openai/gpt-image-2"
    ]
  },
  "rewrite_provider_ids": {
    "description": "提示词优化模型",
    "hint": "第一项为主模型，后续按顺序回退；留空跟随会话。参考图、改图优化与多人检查需要支持视觉的模型，纯文字绘图仍可使用文本模型。",
    "type": "list",
    "default": [],
    "items": {
      "type": "string"
    },
    "_special": "select_providers"
  },
  "quality": {
    "description": "画质 quality",
    "hint": "auto 由模型自动决定；更高质量通常耗时更长。",
    "type": "string",
    "default": "auto",
    "options": ["low", "medium", "high", "auto"]
  },
  "size": {
    "description": "尺寸 size",
    "hint": "1024x1024=方图；1536x1024=横图；1024x1536=竖图；2048x2048=2K 方图；2048x1152=2K 横图；3840x2160=4K 横图；2160x3840=4K 竖图。",
    "type": "string",
    "default": "auto",
    "options": [
      "auto",
      "1024x1024",
      "1536x1024",
      "1024x1536",
      "2048x2048",
      "2048x1152",
      "3840x2160",
      "2160x3840"
    ]
  },
  "moderation": {
    "description": "审核严格度 moderation",
    "hint": "low=较宽松；auto=上游默认。公开场景建议 auto。",
    "type": "string",
    "default": "low",
    "options": ["low", "auto"]
  },
  "concurrency": {
    "description": "最大并发出图数",
    "hint": "超出后自动排队。",
    "type": "int",
    "default": 3
  },
  "style_mode": {
    "description": "内置风格",
    "hint": "auto=未指定画风时优先选相容的内置偏好；explicit_only=仅用户明确点名；disabled=关闭。用户指定画风与编辑保留项优先。",
    "type": "string",
    "default": "auto",
    "options": ["auto", "explicit_only", "disabled"]
  },
  "style_strength": {
    "description": "风格强度",
    "hint": "normal=标准；subtle=轻微；strong=强烈。",
    "type": "string",
    "default": "normal",
    "options": ["normal", "subtle", "strong"]
  },
  "triggers": {
    "description": "直接出图触发词",
    "hint": "可选；命中后绕过主聊天模型，适合输入完整提示词。不要填写 Bot 唤醒词。",
    "type": "list",
    "default": [],
    "items": {
      "type": "string"
    }
  }
}
